{
  "id": "com.hayba.composition.frame_target",
  "version": "1.1.0",
  "category": "composition",
  "title": "Frame Target",
  "description": "Compute a camera transform that orbits and frames a target. The camera is placed on an orbit circle around the target location and looks back at it. Supply the target's world position via 'Target location'; the Slivers panel fills this automatically from the picked actor. If left at the origin, the camera frames the world origin.",
  "author": "core",
  "params": [
    { "id": "target",          "type": "actor_ref", "label": "Target",                 "required": true },
    { "id": "target_location", "type": "vector3",   "label": "Target location (UE units)", "default": [0, 0, 0] },
    { "id": "distance",        "type": "float",     "label": "Distance (m)",           "range": [1, 100],  "default": 10 },
    { "id": "height",          "type": "float",     "label": "Height offset (m)",      "range": [-10, 50], "default": 2 },
    { "id": "fov",             "type": "float",     "label": "Field of view (deg)",    "range": [20, 120], "default": 70 },
    { "id": "yaw_deg",         "type": "float",     "label": "Orbit angle (deg)",      "range": [0, 360],  "default": 45 }
  ],
  "executor": { "kind": "composition.frame_target" },
  "determinism": {
    "pure": true,
    "declared_outputs": ["camera_transform"],
    "side_effects": [],
    "seed_param": null
  }
}
