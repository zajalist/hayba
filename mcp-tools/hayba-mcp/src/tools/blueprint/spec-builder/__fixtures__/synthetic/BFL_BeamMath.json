{
  "asset": "/Game/LanternPuzzle/Core/BFL_BeamMath",
  "$comment": "Synthetic fixture (Lantern Puzzle). Beam maths with no state: a function library has no variables.",
  "create": { "parent": "/Script/Engine.BlueprintFunctionLibrary" },
  "variables": [],
