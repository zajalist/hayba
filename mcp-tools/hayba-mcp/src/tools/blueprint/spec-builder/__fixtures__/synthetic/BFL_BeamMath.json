    { "name": "BeamStrength", "inputs": [{ "name": "Length", "type": "float" }, { "name": "Reach", "type": "float" }, { "name": "Bounces", "type": "int" }, { "name": "Tint", "type": "name" }], "outputs": [{ "name": "Strength", "type": "float" }], "pure": true },
    { "name": "BounceBeam", "inputs": [{ "name": "Mirror", "type": "object:/Script/Engine.SceneComponent" }, { "name": "Start", "type": "vector" }, { "name": "Heading", "type": "vector" }, { "name": "Reach", "type": "float" }, { "name": "Spread", "type": "float" }], "outputs": [{ "name": "bBlocked", "type": "bool" }, { "name": "EndPoint", "type": "vector" }, { "name": "Facing", "type": "rotator" }], "pure": false }
  ],
  "graphs": [
    {
      "graph": "BeamStrength",
      "nodes": {
        "entry": { "entry": true },
        "result": { "result": true },
        "share": { "call": "Divide_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "rest": { "call": "Subtract_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "kept": { "call": "FClamp", "class": "/Script/Engine.KismetMathLibrary" },
        "hops": { "call": "Conv_IntToDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "decay": { "call": "MultiplyMultiply_FloatFloat", "class": "/Script/Engine.KismetMathLibrary" },
        "faded": { "call": "Multiply_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "amber": { "call": "EqualEqual_NameName", "class": "/Script/Engine.KismetMathLibrary" },
        "boost": { "call": "SelectFloat", "class": "/Script/Engine.KismetMathLibrary" },
        "brightest": { "call": "Multiply_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" }
      },
      "links": [
        ["entry.then", "result.execute"],
        ["entry.Length", "share.A"],
        ["entry.Reach", "share.B"],
        ["share.ReturnValue", "rest.B"],
        ["rest.ReturnValue", "kept.Value"],
        ["entry.Bounces", "hops.InInt"],
        ["hops.ReturnValue", "decay.Exp"],
        ["kept.ReturnValue", "faded.A"],
        ["decay.ReturnValue", "faded.B"],
        ["entry.Tint", "amber.A"],
        ["amber.ReturnValue", "boost.bPickA"],
        ["faded.ReturnValue", "brightest.A"],
        ["boost.ReturnValue", "brightest.B"],
        ["brightest.ReturnValue", "result.Strength"]
      ],
      "defaults": {
        "rest.A": "1.0",
        "kept.Min": "0.0",
        "kept.Max": "1.0",
        "decay.Base": "0.8",
        "amber.B": "Amber",
        "boost.A": "1.25",
        "boost.B": "1.0"
      }
    },
    {
      "graph": "BounceBeam",
      "nodes": {
        "entry": { "entry": true },
        "result": { "result": true },
        "note": { "call": "PrintString", "class": "/Script/Engine.KismetSystemLibrary" },
        "alive": { "call": "IsValid", "class": "/Script/Engine.KismetSystemLibrary" },
        "axis": { "call": "GetForwardVector", "class": "/Script/Engine.SceneComponent" },
        "pivot": { "call": "K2_GetComponentLocation", "class": "/Script/Engine.SceneComponent" },
        "gap": { "call": "Subtract_VectorVector", "class": "/Script/Engine.KismetMathLibrary" },
        "far": { "call": "VSize", "class": "/Script/Engine.KismetMathLibrary" },
        "close": { "call": "LessEqual_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "lean": { "call": "Dot_VectorVector", "class": "/Script/Engine.KismetMathLibrary" },
        "inward": { "call": "Less_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "seen": { "call": "BooleanAND", "class": "/Script/Engine.KismetMathLibrary" },
        "usable": { "call": "BooleanAND", "class": "/Script/Engine.KismetMathLibrary" },
        "flipped": { "call": "MirrorVectorByNormal", "class": "/Script/Engine.KismetMathLibrary" },
        "sway": { "call": "RandomFloatInRange", "class": "/Script/Engine.KismetMathLibrary" },
        "drift": { "call": "Multiply_DoubleDouble", "class": "/Script/Engine.KismetMathLibrary" },
        "twist": { "call": "MakeRotator", "class": "/Script/Engine.KismetMathLibrary" },
        "turned": { "call": "GreaterGreater_VectorRotator", "class": "/Script/Engine.KismetMathLibrary" },
        "stretch": { "call": "Multiply_VectorFloat", "class": "/Script/Engine.KismetMathLibrary" },
        "tip": { "call": "Add_VectorVector", "class": "/Script/Engine.KismetMathLibrary" },
        "gaze": { "call": "MakeRotFromX", "class": "/Script/Engine.KismetMathLibrary" },
        "missed": { "call": "Not_PreBool", "class": "/Script/Engine.KismetMathLibrary" }
