      "links": [
        ["entry.then", "note.execute"],
        ["note.then", "result.execute"],
        ["entry.Mirror", "alive.Object"],
        ["entry.Mirror", "axis.self"],
        ["entry.Mirror", "pivot.self"],
        ["pivot.ReturnValue", "gap.A"],
        ["entry.Start", "gap.B"],
        ["gap.ReturnValue", "far.A"],
        ["far.ReturnValue", "close.A"],
        ["entry.Reach", "close.B"],
        ["entry.Heading", "lean.A"],
        ["axis.ReturnValue", "lean.B"],
        ["lean.ReturnValue", "inward.A"],
        ["alive.ReturnValue", "seen.A"],
        ["close.ReturnValue", "seen.B"],
        ["seen.ReturnValue", "usable.A"],
        ["inward.ReturnValue", "usable.B"],
        ["entry.Heading", "flipped.InVect"],
        ["axis.ReturnValue", "flipped.InNormal"],
        ["sway.ReturnValue", "drift.A"],
        ["entry.Spread", "drift.B"],
        ["drift.ReturnValue", "twist.Pitch"],
        ["flipped.ReturnValue", "turned.A"],
        ["twist.ReturnValue", "turned.B"],
        ["turned.ReturnValue", "stretch.A"],
        ["entry.Reach", "stretch.B"],
        ["pivot.ReturnValue", "tip.A"],
        ["stretch.ReturnValue", "tip.B"],
        ["turned.ReturnValue", "gaze.X"],
        ["usable.ReturnValue", "missed.A"],
        ["missed.ReturnValue", "result.bBlocked"],
        ["tip.ReturnValue", "result.EndPoint"],
        ["gaze.ReturnValue", "result.Facing"]
      ],
      "defaults": {
        "note.InString": "BounceBeam",
        "note.bPrintToScreen": "false",
        "note.Duration": "0.5",
        "inward.B": "0.0",
        "sway.Min": "-1.0",
        "sway.Max": "1.0",
        "twist.Roll": "0.0",
        "twist.Yaw": "0.0"
      }
    }
  ]
}
