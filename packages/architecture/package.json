{
  "name": "@hayba/architecture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./culture": {
      "import": "./dist/culture/index.js",
      "types": "./dist/culture/index.d.ts"
    },
    "./schema-v2": {
      "import": "./dist/schema-v2.js",
      "types": "./dist/schema-v2.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:demo && vitest run",
    "test:demo": "node --test demo/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "tsc && node demo/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
