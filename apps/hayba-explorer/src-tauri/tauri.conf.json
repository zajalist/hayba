{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hayba Explorer",
  "version": "0.1.0",
  "identifier": "com.hayba.explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hayba Explorer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1b1e24"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
