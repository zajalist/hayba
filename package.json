{
  "name": "hayba",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic spatial & procedural world-building for Unreal Engine 5 — MCP server + UE5 plugin + worldbuilding packages + website.",
  "keywords": ["mcp", "unreal-engine", "ue5", "procedural-generation", "pcg", "worldbuilding", "ai-agents", "conlang"],
  "homepage": "https://github.com/zajalist/hayba#readme",
  "repository": { "type": "git", "url": "https://github.com/zajalist/hayba.git" },
  "bugs": { "url": "https://github.com/zajalist/hayba/issues" },
  "author": "zajalist",
  "engines": { "node": ">=22.5.0" },
  "workspaces": ["packages/*", "mcp-tools/hayba-mcp"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc -b --noEmit",
    "audit:production": "node mcp-tools/hayba-mcp/scripts/audit-production-dependencies.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "hono": "^4.12.34",
    "undici": "^7.29.0",
    "protobufjs": "^7.6.5",
    "postcss": "^8.5.10"
  },
  "license": "MIT"
}
